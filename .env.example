# Copy to .env and replace the values. Never commit .env.
# Do not put quotes around values.

# Generate with: openssl rand -hex 32
# The application refuses to start if this is shorter than 32 characters.
OPSTRACK_API_KEY=change-me

OPSTRACK_RATE_LIMIT_PER_MINUTE=60

# Password for the application's database user, which has no superuser rights.
DB_USERNAME=opstrack
DB_PASSWORD=change-me

# Password for the PostgreSQL administrator. The application never uses it.
DB_ADMIN_PASSWORD=change-me

# Port on this computer for the API.
APP_PORT=8080
